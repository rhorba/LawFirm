FROM node:22-alpine
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

# Allow build scripts globally (required for esbuild, lmdb, etc. in pnpm 9+)
RUN pnpm config set dangerouslyAllowAllBuilds true

# Copy package files
COPY package.json ./

# Install dependencies
RUN pnpm install

EXPOSE 4200
CMD ["pnpm", "dev", "--host", "0.0.0.0"]
